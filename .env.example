# Backend defaults to the repository root as project "default" and
# backend/data/conversations.sqlite3. RC_PROJECTS replaces RC_PROJECT_PATH.
# Set real absolute local paths in the host environment (or load an ignored .env externally).
# RC_PROJECTS=[{"id":"app-one","name":"App One","path":"C:\\path\\to\\app-one"},{"id":"app-two","name":"App Two","path":"D:\\path\\to\\app-two"}]
# Legacy single-project setting (project ID remains "default"):
# RC_PROJECT_PATH=C:\path\to\project
# RC_DATABASE_PATH=C:\path\to\conversations.sqlite3
