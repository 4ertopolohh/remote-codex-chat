# Только справочная информация: приложение не загружает этот файл автоматически.
# Задавайте значения в окружении процесса backend или подключайте закрытый .env,
# исключённый из Git, через менеджер процессов.
# Не добавляйте в Git настоящий хеш пароля или локальные пути.

# Первоначальная настройка: uv run --no-sync python scripts/configure.py init
# После неё обычный запуск не требует переменных с паролем и проектами.
# Эти переменные используются только для однократной миграции старой установки:
# RC_PASSWORD_HASH=<legacy-Argon2id-hash>

# Локальная разработка: точный HTTP-адрес Vite на loopback-интерфейсе.
# RC_AUTH_MODE=local
# RC_PUBLIC_ORIGIN=http://127.0.0.1:8765

# Удалённый режим: сохраните точный HTTPS Origin командой configure.py set-origin.
# Временные переменные переопределяют сохранённые значения только для текущего процесса.
# RC_AUTH_MODE=remote
# RC_PUBLIC_ORIGIN=https://<assigned-host>.cloudpub.ru

# Необязательный список разрешённых проектов. Пути в JSON должны быть абсолютными;
# обратные косые черты нужно экранировать. RC_PROJECTS заменяет RC_PROJECT_PATH;
# первый проект в списке выбирается по умолчанию.
# RC_PROJECTS=[{"id":"app-one","name":"App One","path":"C:\\Projects\\app-one"}]
# Устаревшая настройка одного проекта; по умолчанию используется корень репозитория.
# RC_PROJECT_PATH=C:\Projects\app-one

# Необязательные пути к постоянным файлам SQLite; по умолчанию — backend/data/.
# RC_DATABASE_PATH=C:\PrivateData\RemoteCodexChat\conversations.sqlite3
# RC_AUTH_DATABASE_PATH=C:\PrivateData\RemoteCodexChat\auth.sqlite3
# RC_CONFIG_DATABASE_PATH=C:\PrivateData\RemoteCodexChat\config.sqlite3

# Необязательный каталог собранного frontend; по умолчанию — frontend/dist.
# RC_FRONTEND_DIST=C:\Projects\remote-codex-chat\frontend\dist

# Необязательные экспериментальные методы app-server; по умолчанию отключены.
# RC_EXPERIMENTAL_FEATURES=1
