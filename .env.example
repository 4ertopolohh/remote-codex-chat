# Documentation only: this file is not loaded automatically. Set values in the
# backend process environment or load a private, ignored .env with your process manager.
# Never commit a real password hash or local paths.

# Required in every mode. Generate in backend/: uv run python scripts/hash_password.py
RC_PASSWORD_HASH=<paste-private-Argon2id-hash-here>

# Local development: exact HTTP loopback origin of the Vite server.
RC_AUTH_MODE=local
RC_PUBLIC_ORIGIN=http://localhost:5173

# Remote mode: use the exact assigned HTTPS tunnel origin instead.
# RC_AUTH_MODE=remote
# RC_PUBLIC_ORIGIN=https://<assigned-host>.cloudpub.ru

# Optional project allowlist. JSON paths must be absolute and escaped for JSON.
# RC_PROJECTS replaces RC_PROJECT_PATH; its first entry is the default.
# RC_PROJECTS=[{"id":"app-one","name":"App One","path":"C:\\Projects\\app-one"}]
# Legacy single-project fallback; default is this repository's root.
# RC_PROJECT_PATH=C:\Projects\app-one

# Optional persistent SQLite files; defaults are under backend/data/.
# RC_DATABASE_PATH=C:\PrivateData\RemoteCodexChat\conversations.sqlite3
# RC_AUTH_DATABASE_PATH=C:\PrivateData\RemoteCodexChat\auth.sqlite3

# Optional frontend build directory; default is frontend/dist.
# RC_FRONTEND_DIST=C:\Projects\remote-codex-chat\frontend\dist

# Optional experimental app-server methods; default is disabled.
# RC_EXPERIMENTAL_FEATURES=1
